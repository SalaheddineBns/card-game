# Copy to .env (gitignored). Read by `docker compose` (compose.yaml) AND by the backend
# (spring.config.import in application.yml), so the password is set in one place.
#   cp .env.example .env && docker compose up -d && (cd backend && ./mvnw spring-boot:run)
POSTGRES_DB=cardgame
POSTGRES_USER=cardgame
POSTGRES_PASSWORD=change-me
