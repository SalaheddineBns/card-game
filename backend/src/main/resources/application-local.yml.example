# Optional. Not needed for the normal local run: the `local` profile settings live in application.yml and
# the database password comes from POSTGRES_PASSWORD in the repo-root .env (also used by docker compose).
# Copy to application-local.yml (gitignored) only for machine-specific overrides, for example:
#
# spring:
#   datasource:
#     url: jdbc:postgresql://localhost:5433/cardgame
# server:
#   port: 8081
