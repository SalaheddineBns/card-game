# Copy to application-local.yml (gitignored) and run with SPRING_PROFILES_ACTIVE=local.
# The committed `local` section of application.yml already enables the dev seed and non-secure cookies;
# this file only holds machine-specific values and secrets.
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/cardgame
    username: cardgame
    password: change-me   # must match POSTGRES_PASSWORD in the root .env used by compose.yaml
